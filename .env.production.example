# =========================================================================
#  Smart Bio GPT - PRODUCTION environment (AWS EC2 + Docker Compose).
#
#      cp .env.production.example .env
#      # fill in every value below, then:
#      docker compose up -d --build
#
#  Keep each value on ONE line - a trailing "# comment" becomes part of it.
#  This file (as .env) is gitignored - never commit real secrets.
# =========================================================================

# ---- make `docker compose up` load the prod overlay automatically ----
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- public address ----
# A DNS A record for this domain MUST point at the server's Elastic IP
# BEFORE first boot (Caddy needs it for the Let's Encrypt HTTP-01 challenge).
PUBLIC_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com
APP_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGINS=https://api.yourdomain.com,https://app.yourdomain.com
# behind Caddy -> gateway there are 2 trusted proxy hops
TRUST_PROXY=2

# GATEWAY_PORT is unused in prod (Caddy owns 80/443) but keep it set:
GATEWAY_PORT=8080

# ---- Postgres (self-hosted in Docker; volume: pgdata) ----
POSTGRES_USER=smartbio
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password
POSTGRES_DB=smartbiogpt

# ---- Redis (self-hosted in Docker; volume: redisdata) ----
REDIS_PASSWORD=CHANGE_ME_long_random_redis_password

# ---- security  (generate fresh - do NOT reuse the dev values) ----
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
#   openssl rand -hex 24
INTERNAL_API_KEY=CHANGE_ME_openssl_rand_hex_24
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Google OAuth ----
# Authorized JavaScript origin must be your PUBLIC site origin
# (e.g. https://app.yourdomain.com and/or https://api.yourdomain.com).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI provider (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MAX_TOKENS=1200

# ---- Email / SMTP (welcome email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=Smart Bio GPT <you@gmail.com>
MAIL_SIGNATURE_NAME=Saiprasad
MAIL_SIGNATURE_TITLE=Creator, Smart Bio GPT

# ---- resilience tuning ----
HTTP_TIMEOUT_MS=12000
HTTP_RETRIES=2
BIO_CACHE_TTL_MS=21600000
LOG_LEVEL=info
