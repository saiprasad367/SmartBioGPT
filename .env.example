# =========================================================================
#  Smart Bio GPT - single environment file for the whole distributed system.
#  Copy to `.env`  (cp .env.example .env)  then:  docker compose up --build
#  Open http://localhost:8088
#
#  NOTE: keep values on their own line - do NOT add trailing "# comments"
#  after a value, Compose treats them as part of the value.
# =========================================================================

# ---- gateway / public URL ----
# Host port the gateway is published on. 8080 is often already taken by other
# local dev tools/agents - 8088 is a safer default. Change all three together.
GATEWAY_PORT=8088
APP_PUBLIC_URL=http://localhost:8088
# extra browser origins allowed to call the API directly (comma-separated)
CORS_ORIGINS=http://localhost:8088

# ---- Postgres (self-hosted, runs in Docker) ----
POSTGRES_USER=smartbio
# CHANGE THIS
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=smartbiogpt

# ---- Redis (self-hosted, runs in Docker) ----
# CHANGE THIS
REDIS_PASSWORD=change-me-redis-password

# ---- security ----
# CHANGE THIS - 32+ random chars.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-value-min-32-chars
# CHANGE THIS - shared secret for service-to-service calls.  openssl rand -hex 24
INTERNAL_API_KEY=change-me-internal-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Google OAuth (Sign in / Sign up with Google) ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application).  Add http://localhost:8088 as an authorized
# JavaScript origin.  The Client ID is public (compiled into the frontend).
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI provider (OpenRouter) - optional ----
# Without a key, chat answers fall back to deterministic database summaries.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ---- Email / SMTP (welcome email) - optional ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Smart Bio GPT <no-reply@smartbiogpt.ai>

# ---- resilience tuning (optional) ----
HTTP_TIMEOUT_MS=12000
HTTP_RETRIES=2
BIO_CACHE_TTL_MS=21600000
LOG_LEVEL=info
