# ---- core ----
NODE_ENV=development
PORT=5000
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- supabase (required) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service-role key: server-only, enables privileged DB writes. Strongly recommended.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI (optional - falls back to deterministic answers when missing) ----
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.0-flash-001
APP_PUBLIC_URL=http://localhost:8080

# ---- email via SMTP / nodemailer (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Smart Bio GPT <no-reply@smartbiogpt.ai>

# ---- resilience tuning (optional) ----
HTTP_TIMEOUT_MS=12000
HTTP_RETRIES=2
BIO_CACHE_TTL_MS=21600000
LOG_LEVEL=debug
