# Frontend build/dev config.
#
# In Docker these are passed as build args by docker-compose (VITE_API_URL=/api,
# VITE_GOOGLE_CLIENT_ID from the root .env) - you do NOT need this file then.
#
# For running `npm run dev` directly against a local gateway:

# Base URL of the API. Same-origin "/api" when served behind the gateway.
VITE_API_URL=/api

# Public Google OAuth client id (from Google Cloud Console). Leave blank to
# hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
